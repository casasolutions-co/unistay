37/9d359be2-3cad-4f29-9ed9-6181cb3153ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":null,"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1260637/9d359be2-3cad-4f29-9ed9-6181cb3153ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1260637/9d359be2-3cad-4f29-9ed9-6181cb3153ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1260637/9d359be2-3cad-4f29-9ed9-6181cb3153ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1260637/9d359be2-3cad-4f29-9ed9-6181cb3153ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1260637/9d359be2-3cad-4f29-9ed9-6181cb3153ce.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Objektbeschreibung:\nDie Wohnung liegt im Erdgeschoss eines Mehrfamilienhauses und besticht durch eine gehobene Innenausstattung. Zwei helle und freundliche Zimmer laden zur freien Entfaltung ein und sind hochwertig ausgestattet. Durch einen Fahrstuhl gelangen Sie bequem ins entsprechende Stockwerk und das Objekt ist barrierefrei zugänglich. Besonders hervorzuheben ist, dass  Sie den Garten der Wohnung (ca. 87 m2) exklusiv nutzen können. Ihnen stehen außerdem eine Einbauküche mit hochwertigen Markengeräten (Induktionsherd, Backofen, großer Kühlschrank, Spülmaschine).  Ein Stellplatz für Ihr Auto und ein Kellerraum steht Ihnen ebenfalls zur Verfügung.\n\nAusstattung:\nEichenparkett, Fußbodenheizung mit Luftwärmepumpe, Marken-Einbauküche, große, überdachte Terrasse und Garten 87 m2 zur Exklusiv-Nutzung, TG Stellplatz, Besucher-Stellplätze, elektrische Rollos, automatische Belüftungsanlage. \n\nMöblierung:\nDie Wohnung wird vollständig möbliert, die Einrichtungsbilder beziehen sich auf ein anderes Objekt, welches im gleichen Standard eingerichtet wurde.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"no"},"flooring":{"value":"wood"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"no"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"discussable"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"62"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"yes"},"wifi":{"value":"no"}},"costs":{"currency":"EUR","pricing":"monthly","price":185000,"deposit":360000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1850.00","deposit":"3600.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-04-09"}],"updated":"2026-04-09T12:23:06Z","__utId__":"ut1260637"}]