immer mit einem TRECA Hotelbett (140cmx200cm) sowie eine Schlafcouch (140x200), einen 42 Zoll Flat TV, mit kostenlosem NETFLIX ,Schreibtisch. \nDer Flur hat einen Kleiderschrank und ein Funktelefon. \nDie Küche ist ausgestattet mit einem Frühstückstisch, Kühlschrank,\nWaschmaschine,E-Kochfeld, Kaffeevollautomat, Toaster,Wasserkocher.\nDusche und Toilette sind getrennt. \nEs besteht ein kostenloser WLAN Zugang und kostenloses telefonieren ins deutsche Festnetz ist ebenso möglich. Die Bushaltestelle mit Anschluss zum Frankfurter Flughafen oder S-Bahnstation befindet sich zwei Gehminuten entfernt.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"private"},"basement":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"0"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"no"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"private"},"gasCostIncluded":{"value":"yes"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"shared"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"toilet":{"value":"private"},"totalSize":{"value":"35"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":139500,"deposit":100000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1395.00","deposit":"1000.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":32,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":""