14-a2c9-42ce-ab09-e720e5c84c24.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1679771/3b19fc14-a2c9-42ce-ab09-e720e5c84c24.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"Exklusive, voll möblierte Luxuswohnung (115 m2) in ruhiger Lage nahe Nürnberg/Fürth. Dieses stilvolle Apartment verbindet hochwertiges Design mit maximalem Komfort – ideal für Berufstätige, Expats oder Paare auf Zeit.\n\nHighlights & Räume\n\t•\tOffener, großzügiger Wohnbereich mit echtem Kamin und Lounge-Balkon – perfekter Ort zum Entspannen.\n\t•\tVoll ausgestattete Küche: Backofen, Herd, Spülmaschine, Toaster, Mixer, Kaffeemaschine – ideal für Selbstversorger.\n\t•\tSchlafzimmer mit großem Doppelbett + bequemes Schlafsofa im Wohnzimmer → Schlafplätze für bis zu 4 Personen.\n\t•\tBegehbarer Kleiderschrank (verbunden mit kleinem Fitness-/Ankleidebereich).\n\t•\tModernes Bad mit Regendusche; zusätzlicher Hauswirtschaftsraum mit Waschmaschine & Trockner.\n\t•\tMarmorboden & Fußbodenheizung in allen Räumen, modernes LED-Lichtkonzept.\n\t•\tSmart-TV, schnelles WLAN, Parkplatz inklusive.\n\nWarum diese Wohnung?\n\t•\tLuxuriöses Interieur & durchdachte Raumaufteilung.\n\t•\tRuhige Lage, trotzdem schnelle Anbindung an Nürnberg/Fürth.\n\t•\tOptimal für längere Aufenthalte (ab 1 Monat): Expat- und Geschäftsreisende finden hier ein komplett eingerichtetes, sorgenfreies Zuhause.\n\nAusstattung (kurz)\nKamin • Balkon • Designer-Möbel • Marmorboden • Fußbodenheizung • Voll ausgestattete Küche (Backofen, Herd, Spülmaschine) • Waschmaschine & Trockner • Begehbarer Kleiderschrank • Fitness-Corner • Regendusche • Smart-TV • WLAN • Parkplatz\n\nVerfügbarkeit & Mindestmietdauer\nBevorzugt ab 1 Monat (ideal 2–6 Monate). Bei Interesse bitte gewünschte Mietzeitraum angeben — ich antworte schnell.","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"yes"},"balconyTerrace":{"value":"private"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"stone"},"garden":{"value":"shared"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"discussable"},"playMusic":{"value":"yes"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"outside_only"},"toilet":{"value":"private"},"totalSize":{"value":"115"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":255000,"deposit":510000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"2550.00","deposit":"5100.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":1,"moveInWindow":0,"currentOccupancy":0,"minAge":0,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-03-30"}],"updated":"2026-03-30T11:00:06Z","__utId__":"ut1679771"}]