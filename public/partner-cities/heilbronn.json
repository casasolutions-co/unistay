ype/1700868/06853e40-55f1-4c92-8841-6c502c138728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1700868/06853e40-55f1-4c92-8841-6c502c138728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1700868/06853e40-55f1-4c92-8841-6c502c138728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1700868/06853e40-55f1-4c92-8841-6c502c138728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1700868/06853e40-55f1-4c92-8841-6c502c138728.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}},{"originalLink":"https://housinganywhere.imgix.net/unit_type/1700868/071bd4c2-d29b-46fc-b96b-7e44726b8132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","categories":["floorplan"],"sizes":{"1024x768":{"link":"https://housinganywhere.imgix.net/unit_type/1700868/071bd4c2-d29b-46fc-b96b-7e44726b8132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=768&w=1024","width":1024,"height":768},"2048x1536":{"link":"https://housinganywhere.imgix.net/unit_type/1700868/071bd4c2-d29b-46fc-b96b-7e44726b8132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=1536&w=2048","width":2048,"height":1536},"320x240":{"link":"https://housinganywhere.imgix.net/unit_type/1700868/071bd4c2-d29b-46fc-b96b-7e44726b8132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=240&w=320","width":320,"height":240},"640x480":{"link":"https://housinganywhere.imgix.net/unit_type/1700868/071bd4c2-d29b-46fc-b96b-7e44726b8132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=480&w=640","width":640,"height":480},"800x600":{"link":"https://housinganywhere.imgix.net/unit_type/1700868/071bd4c2-d29b-46fc-b96b-7e44726b8132.jpg?auto=format%2Ccompress&cs=srgb&fit=clip&h=600&w=800","width":800,"height":600}}}],"videos":null,"description":"\nDie angebotene 2-Zimmer-Wohnung befindet sich im 1. Obergeschoss und überzeugt durch eine lichtdurchflutete Raumgestaltung sowie eine hochwertige Ausstattung.\n\nEin Hausmeisterservice, die Kehrwoche sowie der Winterdienst werden für Sie übernommen – Sie können sich entspannt zurücklehnen und Ihr neues Zuhause genießen.\n\nEin besonderes Highlight ist die gemeinschaftlich nutzbare Dachterrasse mit beeindruckendem Ausblick sowie ein Fahrradraum.\n\n**Wohnen & Ausstattung**\n\nDie Wohnung wird **vollständig möbliert und bezugsfertig** angeboten – ideal für alle, die Wert auf Komfort und ein stilvolles Zuhause legen.\n\nEin hochwertiger Parkettboden sowie eine harmonische Raumgestaltung schaffen eine angenehme Wohnatmosphäre.\n\nDer Wohn- und Essbereich ist geschmackvoll eingerichtet und verfügt über einen Esstisch mit Stühlen sowie – auf Wunsch – einen Smart-TV.\n\nDie offen gestaltete Einbauküche ist hochwertig ausgestattet und umfasst neben Kühlschrank-/Gefrierkombination, Backofen, Herd mit Dunstabzug und Spülmaschine zusätzlich:\nMikrowelle, Kaffeemaschine, Toaster, Wasserkocher sowie vollständiges Kücheninventar.\n\nIm Schlafbereich erwarten Sie ein komfortables Bett und ein geräumiger Kleiderschrank.\n\nDas moderne Badezimmer überzeugt mit einer ebenerdigen Dusche, einem stilvollen Waschbecken, WC sowie einem Handtuchheizkörper und hochwertigen Armaturen.\n\n**Weitere Annehmlichkeiten**\n\n* Waschmaschine im Apartment\n* Pflegeleichter Fliesenboden im Bad\n* Internetanschluss im Haus vorhanden\n\n**All-Inclusive-Komfort**\n\nDie Wohnung wird als **Rundum-sorglos-Paket** vermietet:\nIn der Pauschalmiete sind bereits sämtliche Nebenkosten enthalten – inklusive Strom, Wasser, Heizung, WLAN sowie Hausmeisterservice.\n\nKeine Nebenkostenabrechnung, kein zusätzlicher Aufwand – einfach einziehen und wohlfühlen.\nAusstattung\n**Ausstattung im Überblick:**\n\n* Lichtdurchflutete Räume mit modernem, durchdachtem Grundriss\n* Hochwertige Möblierung – vollständig bezugsfertig\n* Stilvoll eingerichteter Wohn- und Essbereich mit Esstisch, Stühlen und optionalem Smart-TV\n* Komfortabler Schlafbereich mit Bett, geräumigem Kleiderschrank und integrierter Garderobe\n* Hochwertiger Parkettboden in den Wohnräumen, moderne Fliesen im Bad\n* Fußbodenheizung mit Einzelraumsteuerung\n* Moderne Einbauküche mit Kühl-/Gefrierkombination, Backofen, Herd mit Dunstabzug und Spülmaschine\n* Zusätzlich voll ausgestattet mit Mikrowelle, Kaffeemaschine, Toaster, Wasserkocher und Kücheninventar\n* Einbauküche wird separat mitvermietet\n* Badezimmer mit ebenerdiger Dusche, WC, Waschbecken und Handtuchheizkörper\n* Alu-Fenster mit elektrischen Markisoletten und Textilrollos\n* Videoeingangsüberwachungssystem\n* WLAN\n* Waschmaschine und Trockner\n* Gemeinschaftliche Dachterrasse und Fahrradraum\n* Kellerraum vorhanden\n* Hausmeisterservice, Kehrwoche und Winterdienst inklusive\n* Energieeffiziente Bauweise (KfW 55 EE, Photovoltaik, Nahwärme)\n* Vermietung als All-Inclusive-Konzept (inkl. Strom, Wasser, Heizung, WLAN)\n* Vereinbarung einer Indexmiete","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"no"},"basement":{"value":"private"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"wood"},"garden":{"value":"no"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"no"},"parking":{"value":"no"},"pets":{"value":"discussable"},"playMusic":{"value":"discussable"},"registrationPossibl