provides modern furnishings and a high level of comfort.\n It is  beautifully located in a save and quiet neighborhood, giving you quick access to Bensheim city center (5 mins) and to popular hiking /mountainbiking trails in magnificent vinyards at the same time. \nEnjoy relaxation after work barbecuing on the sun terrace. You can reach Bensheim city center, the IC train station and the highway (A5, A67) in just a few minutes, giving you quick access to the Rhine-Neckar metropolitan region (Darmstadt = 20 minutes; Heidelberg/Mannheim/Frankfurt 30 minutes). Popular restaurants are located within walking distance.\n\nThe apartment is top renovated and provides \n- a spacious living room with a large leather couch, dining table, television and home office equipment.\n- a comfortable bedroom with a large king size double bed with shutters to guarantee sleeping in full darkness if wanted.\n- a luxury 13 m2 daylight bathroom with bath tub, shower, double vanity, ergometer, washing machine and tumbler\n- a spacious kitchen with a magnificent view of the vineyards including everything you need for cooking (cookware, fridge, dishwasher, microwave, oven, coffee machine etc.) \n- fast fiber optic wifi guarantees quick internet access and free parking is available. ","facilities":{"airConditioning":{"value":"no"},"allergyFriendly":{"value":"no"},"balconyTerrace":{"value":"shared"},"basement":{"value":"no"},"bathroom":{"value":"private"},"bed":{"value":"yes"},"bedroomFurnished":{"value":"yes"},"bedroomLock":{"value":"yes"},"bedroomSize":{"value":"20"},"bedrooms":{"value":"1"},"closet":{"value":"yes"},"couplesAllowed":{"value":"yes"},"desk":{"value":"yes"},"dishwasher":{"value":"yes"},"dryer":{"value":"yes"},"electricityCostIncluded":{"value":"yes"},"flooring":{"value":"laminate"},"gasCostIncluded":{"value":"yes"},"heating":{"value":"central"},"internetCostIncluded":{"value":"yes"},"kitchen":{"value":"private"},"kitchenware":{"value":"private"},"livingRoom":{"value":"private"},"parking":{"value":"private"},"pets":{"value":"no"},"playMusic":{"value":"no"},"registrationPossible":{"value":"yes"},"roomFurniture":{"value":"yes"},"smoking":{"value":"no"},"tenantStatus":{"value":"working professionals only"},"toilet":{"value":"private"},"totalSize":{"value":"78"},"tv":{"value":"yes"},"washingMachine":{"value":"yes"},"waterCostIncluded":{"value":"yes"},"wheelchairAccessible":{"value":"no"},"wifi":{"value":"yes"}},"costs":{"currency":"EUR","pricing":"monthly","price":175000,"deposit":170000,"agencyFee":0,"estimatedBills":0},"costsFormatted":{"currency":"EUR","pricing":"monthly","price":"1750.00","deposit":"1700.00","agencyFee":"0.00","estimatedBills":"0.00"},"minimumStayMonths":3,"moveInWindow":0,"currentOccupancy":1,"minAge":25,"maxAge":0,"preferredGender":"","available":[{"to":"9999-12-31","from":"2026-03-30"}],"updated":"2026-03-30T10:51:11Z","__utId__":"ut1574104"}]